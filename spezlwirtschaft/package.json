{
  "name": "spezlwirtschaft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "db:migrate:local": "wrangler d1 execute spezlwirtschaft-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute spezlwirtschaft-db --remote --file=./migrations/0001_init.sql",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.1",
    "wrangler": "^3.78.0"
  }
}
